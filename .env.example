# Telegram Bot Project - Environment Variables Example
# Copy this file to .env and fill in the values

# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# API Token for external services
API_TOKEN=your_api_token_here

# Django Secret Key (generate a random string)
# You can generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-to-a-random-secret-key

# Database Configuration
DB_NAME=telegram_bot_db
DB_USER=bot_user
DB_PASSWORD=change-this-to-strong-password
DB_HOST=localhost
DB_PORT=5432

# Django Settings
DEBUG=True

# Allowed Hosts (comma-separated for production)
ALLOWED_HOSTS=localhost,127.0.0.1
